      "parameters": {
        "jsCode": "const b=$json.body||{};\nconst clean=v=>typeof v==='string'?v.trim():'';\nconst first=clean(b.firstName),last=clean(b.lastName),email=clean(b.email).toLowerCase();\nif(!first||first.length>60||!last||last.length>60||email.length>254||!/^[^\\s@<>\"(),;:]+@[^\\s@<>\"(),;:]+\\.[a-z]{2,}$/i.test(email)||!/^[-a-zA-Z0-9]{16,80}$/.test(b.id||'')||!Number.isFinite(Date.parse(b.at)))return [{json:{valid:false}}];\nreturn [{json:{request_id:b.id,requested_at:b.at,first_name:first,last_name:last,email,source:'zemi-aku testflight'}}];"
      }
    },
