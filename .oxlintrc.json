{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "app/vendor/**",
    "cache/**",
    "data/**",
    "node_modules/**"
  ],
  "rules": {
    "no-unused-vars": "warn",
    "unicorn/prefer-string-starts-ends-with": "warn"
  }
}
