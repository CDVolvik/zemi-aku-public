# Qloo hackathon key (arrives by email after the request form). Works only with the hackathon base URL.
QLOO_API_BASE=https://hackathon.api.qloo.com
QLOO_API_KEY=
# Deepgram: Aura-2 voices and nova-3 live speech-to-text
DEEPGRAM_API_KEY=
# Text agent: DeepSeek V4.1 Flash via OpenRouter (ZEMI_MODEL overrides). Set a credit limit on this key in OpenRouter too.
OPENROUTER_API_KEY=
# Persistent daily chat budget (USD); 0 disables paid chat. UTC day, shared by all visitors.
ZEMI_CHAT_USD_PER_DAY=1
# Public HTTPS origin, reachable by Deepgram. Empty keeps the standard voice loop on localhost.
ZEMI_PUBLIC_URL=
# Persistent Voice Agent minutes per UTC day, shared by all visitors; 0 disables it.
ZEMI_VOICE_MINUTES_PER_DAY=120
# Voice model spending also counts against the shared chat cap; preserves text allowance.
ZEMI_VOICE_CHAT_USD_PER_DAY=0.5
# Census key: node scripts/census.mjs builds the municipality demographics cache.
CENSUS_API_KEY=
# Cesium ion browser token (ion.cesium.com/tokens). Restrict it to the demo URL. Empty keeps terrain/3D off.
CESIUM_ION_TOKEN=
# Keep Google tiles disabled until geocoder/licensing requirements are satisfied; OSM 3D stays available.
ZEMI_PHOTOREAL_ENABLED=0
# Optional free AISStream feed. Server-only key; leave disabled until regional coverage is verified.
AISSTREAM_API_KEY=
ZEMI_AIS_ENABLED=0
# Shared UTC-day provider caps; 0 disables the corresponding path.
ZEMI_SPEAK_CHARS_PER_DAY=150000
ZEMI_LISTEN_MINUTES_PER_DAY=120
ZEMI_QLOO_CALLS_PER_DAY=6000
# TestFlight requests from the front page are forwarded here (e.g. a Make or n8n webhook into a sheet).
# The hosted container's disk does not survive a deploy, so set this before hosting.
TESTER_WEBHOOK_URL=
# n8n Header Auth: the server sends this as X-Zemi-Webhook-Secret. Never a browser credential.
TESTER_WEBHOOK_SECRET=
# 16+ characters. Lets you download the requests: GET /api/testers.csv with 'Authorization: Bearer <token>'.
ADMIN_TOKEN=
# Optional public TestFlight link from App Store Connect (https://testflight.apple.com/join/…).
# When set, the front page shows "Get the beta on TestFlight" instead of the email request form.
# Public links usually cap around 10 testers; leave commented to keep the request form.
# TESTFLIGHT_PUBLIC_URL=
